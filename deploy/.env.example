# Copiar a deploy/.env y completar. deploy/.env NO se sube a git.

# Subdominio de DuckDNS (sin https://), p. ej. mi-erp.duckdns.org
DOMAIN=

# Generar cada uno con: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=

# Usuario que crea las empresas. La contraseña solo se usa la primera vez que arranca el
# backend (crea el usuario si no existe); después se puede borrar de acá.
ERP_PLATFORM_ADMIN_USERNAME=platform_admin
ERP_PLATFORM_ADMIN_EMAIL=
ERP_PLATFORM_ADMIN_PASSWORD=

# Duración de la sesión (24 h) y memoria máxima del backend.
JWT_EXPIRATION_MS=86400000
JAVA_OPTS=-Xmx1g
